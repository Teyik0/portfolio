{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Théo Samarasinghe (Teyik0) personal site: a Furin SSG page with a three.js signal field.",
  "type": "module",
  "scripts": {
    "build": "furin build --target bun",
    "build:vercel": "furin build --target vercel",
    "dev": "bun --hot src/server.ts",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "start": "bun .furin/build/bun/server.js",
    "tscheck": "tsc --noEmit",
    "typegen": "furin typegen"
  },
  "dependencies": {
    "@teyik0/furin": "0.8.0-alpha.0",
    "bun-plugin-tailwind": "^0.1.2",
    "elysia": "2.0.0-beta.32",
    "evlog": "^2.33.0",
    "exact-mirror": "1.2.6",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
